# RAM apps and a separate installer ROM. Existing static Makefile is unchanged.
CC = m68k-palmos-gcc
PYTHON = python3
LIB ?= $(abspath ../repos/fujinet-nio-lib)
FNPALM ?= $(abspath ../repos/fujinet-palm/palm/apps)
B ?= build/shared
CLIENT ?= $(LIB)/build/palmos-shared-m3/libniolib-client.a
LIBPRC ?= $(LIB)/build/palmos-shared-m3/NioLib.prc
TESTPRC ?= $(LIB)/build/palmos-shared-m3/NioLibTest.prc
CFLAGS = -O2 -Wall -palmos3.5 -Inio-lib/shim -I$(LIB)/include -I$(LIB)/include/palmos -Icompat -DNIO_SHARED_CLIENT
COMPAT = compat/fn_classic.c compat/fnapp.c
.PHONY: all apps rom verify
all: apps rom verify
apps: $(B)/isstracker.prc $(B)/weather.prc

define app
$(B)/$(1)/$(1): $(FNPALM)/$(1)/$(1).c $(COMPAT) $(CLIENT)
	mkdir -p $$(@D)
	$(CC) $(CFLAGS) -I$(FNPALM)/$(1) -Wl,-Map,$$@.map -o $$@ $(FNPALM)/$(1)/*.c $(COMPAT) $(CLIENT)
	m68k-palmos-nm -n $$@ > $$@.symbols
	m68k-palmos-objdump -d $$@ > $$@.dis
$(B)/$(1)/resources.stamp: $(FNPALM)/$(1)/$(1).rcp
	mkdir -p $$(@D)
	cd $$(@D) && pilrc -q -I $(FNPALM)/$(1) $(FNPALM)/$(1)/$(1).rcp
	touch $$@
$(B)/$(1).prc: $(B)/$(1)/$(1) $(B)/$(1)/resources.stamp
	cd $(B)/$(1) && build-prc -o $(abspath $(B))/$(1).prc $(FNPALM)/$(1)/$(1).def $(1) *.bin
endef
$(foreach a,isstracker weather,$(eval $(call app,$(a))))

$(B)/installer/installer: installer/installer.c Makefile.shared
	mkdir -p $(@D)
	$(CC) -O2 -Wall -Werror -palmos3.5 -o $@ $<
	m68k-palmos-nm -n $@ > $@.symbols
	m68k-palmos-objdump -d $@ > $@.dis
$(B)/installer/resources.stamp: $(LIBPRC) $(TESTPRC) $(B)/isstracker.prc $(B)/weather.prc installer/package.py
	mkdir -p $(@D)
	$(PYTHON) installer/package.py resources $(@D) $(LIBPRC) $(TESTPRC) $(B)/isstracker.prc $(B)/weather.prc
	touch $@
$(B)/installer.prc: $(B)/installer/installer $(B)/installer/resources.stamp
	build-prc -c HsCd -n "NioLib M3 Setup" -o $(B)/installer-raw.prc $< $(B)/installer/nPRC*.bin
	$(PYTHON) installer/package.py setup $(B)/installer-raw.prc $@
$(B)/Palm-MakeROM:
	$(MAKE) -f Makefile $(B)/Palm-MakeROM B=$(B)
rom: $(B)/niolib-m3.rom
$(B)/niolib-m3.rom: $(B)/installer.prc $(B)/Palm-MakeROM
	$(B)/Palm-MakeROM -op create -hdr 0x08000000 -romBlock 0x08000000 0x10000 -chChecksum -chName "NioLib M3" -chManuf "FujiNet" -chVersion 0x0100 -chZCrDate -romName "NioLib M3 Setup" -autoSize -tokStr HsAT 330 -romDB $< -o $@
verify: apps $(B)/niolib-m3.rom
	$(PYTHON) installer/package.py verify $(B) $(LIBPRC) $(TESTPRC)
